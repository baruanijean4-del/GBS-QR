                         "@radix-ui/react-toggle":  "^1.1.10",
                         "@radix-ui/react-tooltip":  "^1.2.8",
                         "@sentry/node":  "^11.6.0",
                         "@sentry/react":  "^11.6.0",
                         "@tanstack/react-query":  "^5.90.16",
                         "@trpc/client":  "^11.8.1",
                         "@trpc/react-query":  "^11.8.1",
                         "@trpc/server":  "^11.8.1",
                         "@types/qrcode":  "^1.5.6",
                         "@zxing/browser":  "^0.2.1",
                         "class-variance-authority":  "^0.7.1",
                         "clsx":  "^2.1.1",
                         "dotenv":  "^17.2.3",
                         "drizzle-orm":  "^0.45.1",
