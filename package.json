{
    "name":  "my-app",
    "private":  true,
    "version":  "0.0.0",
    "engines":  {
                    "node":  "\u003e=24.0.0 \u003c25.0.0"
                },
    "type":  "module",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "vite build \u0026\u0026 node scripts/inline-css.mjs \u0026\u0026 node scripts/versionner-sw.mjs \u0026\u0026 node scripts/compresser-assets.mjs \u0026\u0026 esbuild api/boot.ts --platform=node --bundle --format=esm --outdir=dist --banner:js=\"import { createRequire as __gbsCreateRequire } from \u0027module\u0027;const require = __gbsCreateRequire(import.meta.url);\"",
                    "lint":  "eslint .",
                    "preview":  "vite preview",
                    "start":  "NODE_ENV=production node dist/boot.js",
                    "check":  "tsc -b",
                    "i18n":  "node scripts/controle-i18n.mjs",
                    "format":  "prettier --write .",
                    "test":  "vitest run",
                    "db:generate":  "drizzle-kit generate",
                    "db:migrate":  "drizzle-kit migrate",
                    "db:push":  "drizzle-kit push",
                    "db:status":  "drizzle-kit check",
                    "db:seed":  "tsx db/seed.ts",
                    "db:seed:demo":  "tsx db/seed.ts --avec-demo",
                    "db:reset":  "node scripts/reinit-base-locale.mjs",
                    "db:reset:demo":  "node scripts/reinit-base-locale.mjs --demo"
                },
    "dependencies":  {
                         "@hono/node-server":  "^1.14.3",
