# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # PostgreSQL / Neon connection string (postgresql://user:pass@host/db?sslmode=require)

# ── Sécurité ───────────────────────────────────────────────────
SESSION_SECRET=           # OBLIGATOIRE en production : 32+ caractères aléatoires (openssl rand -hex 32) — démarrage refusé sinon
ADMIN_PIN=                # OBLIGATOIRE en production : PIN super-admin (8+ car., stocké en clair — jamais haché) — démarrage refusé sinon
# ADMIN_TELEPHONE=          # Téléphone du compte super-admin (défaut : +243970000000)

# ── Mode démo (développement / démonstration uniquement) ───────
# ANNUAIRE_DEMO=true      # INTERDIT en production (démarrage refusé). Développement uniquement.
                          # Par défaut OFF. Refus de démarrer si true en production.

# ── Supervision (optionnel) ────────────────────────────────────
# SENTRY_DSN=             # DSN Sentry backend (erreurs 5xx uniquement, PIN/jetons filtrés)
# VITE_SENTRY_DSN=        # DSN Sentry frontend (injecté au build Vite)
