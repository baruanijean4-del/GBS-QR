# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
# CHAÎNE DIRECTE (sans -pooler) — obligatoire pour Drizzle / Neon
DATABASE_URL=postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE.neon.tech/NOM_BASE?sslmode=require

# ── Sécurité (générer des valeurs ALÉATOIRES, jamais réutiliser) ─
# ADMIN_PIN : 6 chiffres minimum, non devinable
ADMIN_PIN=CHANGER_MOI
ADMIN_TELEPHONE=+243000000000
# openssl rand -hex 32
SESSION_SECRET=CHANGER_MOI
PIN_ENC_KEY=CHANGER_MOI

# ── Mode démo (INTERDIT en production) ─────────────────────────
# ANNUAIRE_DEMO=true
